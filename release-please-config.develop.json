{
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "prerelease": true,
  "prerelease-type": "alpha",
  "packages": {
    "platform": {
      "release-type": "simple",
      "component": "platform",
      "package-name": "thiscloud-platform",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"thiscloudd\")].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"thiscloud-cli\")].version"
        }
      ]
    },
    "platform/web-ui": {
      "release-type": "node",
      "component": "web-ui",
      "package-name": "thiscloud-web"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "thiscloud",
      "components": ["platform", "web-ui"]
    }
  ]
}
