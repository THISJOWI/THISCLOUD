{
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "prerelease": true,
  "prerelease-type": "alpha",
  "versioning": "prerelease",
  "packages": {
    "platform": {
      "release-type": "simple",
      "component": "platform",
      "package-name": "thiscloud-platform",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"thiscloudd\")].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==\"thiscloud-cli\")].version"
        },
        {
          "type": "json",
          "path": "web-ui/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web-ui/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web-ui/package-lock.json",
          "jsonpath": "$.packages[\"\"].version"
        }
      ]
    }
  }
}
